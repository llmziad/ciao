# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Auth ----
# 32+ char random string. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in invite/reset links, QR target, vCard)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Email (Resend) ----
# If RESEND_API_KEY is unset, the app uses the Console email transport (logs links to stdout).
RESEND_API_KEY=""
EMAIL_FROM="ICAO Digital Identity <noreply@your-domain>"

# ---- Storage ----
# If BLOB_READ_WRITE_TOKEN is unset, the app uses local filesystem storage (public/uploads).
BLOB_READ_WRITE_TOKEN=""

# ---- Seed (super admin bootstrapped by prisma/seed.ts) ----
SEED_SUPERADMIN_EMAIL="admin@icao.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"
SEED_SUPERADMIN_NAME="ICAO Super Admin"
